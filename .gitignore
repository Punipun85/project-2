# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment secrets (examples are explicitly allow-listed below)
.env
.env.local
.env.production
.env.*.local
.env*
/.dev.vars
!/.env.example
!/.env.vercel.example
!/.dev.vars.example
!/data-pipeline/.env.example
!/nexaplay-embedding-service/.env.example
!/recommendation-service/.env.example
!/worker-service/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.dev*.log
/.start-test*.log
/outputs/
/work/

# python
__pycache__/
*.py[cod]
.venv/
/data-pipeline/data/imdb/
