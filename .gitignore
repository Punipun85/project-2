# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/.dev.vars
!/.dev.vars.example
!/data-pipeline/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.dev*.log
/.start-test*.log
/outputs/
/work/

# python
__pycache__/
*.py[cod]
.venv/
/data-pipeline/data/imdb/
