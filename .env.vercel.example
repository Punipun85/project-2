# Add these values in Vercel Project Settings -> Environment Variables.
# This file is documentation only. Never commit populated secrets.

APP_ENV=production
# Vercel sets NODE_ENV=production automatically; do not override it in the dashboard.
NODE_ENV=production

# Public browser configuration. This is the only NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com

# Everything below is server-only. Never add NEXT_PUBLIC_ to these names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Only needed by trusted server jobs. The NexaPlay web runtime does not need it.
SUPABASE_SERVICE_ROLE_KEY=

EMBEDDING_API_URL=https://embedding.example.com/ai/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_TIMEOUT_SECONDS=30

REMOTE_AI_BASE_URL=https://ai.punipuni.my.id/v1
REMOTE_AI_API_KEY=
REMOTE_AI_DEFAULT_MODEL=ag/gemini-3.7-flash-high
REMOTE_AI_REASONING_MODEL=cx/gpt-5.6-sol
REMOTE_AI_FALLBACK_MODEL=cx/gpt-5.6-terra

RECOMMENDATION_API_URL=https://recommendation.example.com/recommendations
RECOMMENDATION_API_KEY=

WORKER_API_URL=https://worker.example.com
WORKER_API_KEY=

TMDB_API_KEY=
