# Required. Generate a long random value and keep it in the deployment secret manager.
EMBEDDING_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PORT=8000

# Comma-separated origins. Server-to-server callers do not require CORS.
# Example: https://nexaplay.example.com,https://www.nexaplay.example.com
CORS_ORIGINS=http://localhost:3000

REQUEST_TIMEOUT_SECONDS=30
MAX_TEXT_LENGTH=12000
LOG_LEVEL=INFO
