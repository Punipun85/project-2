# NexaPlay AI remote gateway configuration.
# The developer must insert the API key manually in a local .env or the
# deployment secret manager. Never commit the populated key.
REMOTE_AI_BASE_URL=https://ai.punipuni.my.id/v1
REMOTE_AI_API_KEY=
REMOTE_AI_DEFAULT_MODEL=ag/gemini-3.7-flash-high
REMOTE_AI_REASONING_MODEL=cx/gpt-5.6-sol
REMOTE_AI_FALLBACK_MODEL=cx/gpt-5.6-terra
