# NexaPlay root application environment contract.
# Copy to `.env.local` for standard Next.js development or `.env` for the
# existing Vinext development command. Never commit populated environment files.

# Public browser configuration. This is the only NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only application configuration. Never rename these with NEXT_PUBLIC_*.
APP_ENV=local
NODE_ENV=development

# Supabase — web uses the public anon key. The service-role key is allowed only
# in trusted scripts/workers and must never be exposed through NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only FastAPI embedding service.
# Local/LAN example: http://192.168.1.20:8000/ai/embed
# Production example: https://embedding.example.com/ai/embed
EMBEDDING_API_URL=http://127.0.0.1:8000/ai/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_TIMEOUT_SECONDS=30

# Server-only 9Router OpenAI-compatible LLM gateway.
REMOTE_AI_BASE_URL=https://ai.punipuni.my.id/v1
REMOTE_AI_API_KEY=
REMOTE_AI_DEFAULT_MODEL=ag/gemini-3.7-flash-high
REMOTE_AI_REASONING_MODEL=cx/gpt-5.6-sol
REMOTE_AI_FALLBACK_MODEL=cx/gpt-5.6-terra

# Server-only standalone recommendation service.
# Local example: http://127.0.0.1:8100/recommendations
# Production example: https://recommendation.example.com/recommendations
RECOMMENDATION_API_URL=http://127.0.0.1:8100/recommendations
RECOMMENDATION_API_KEY=

# Server-only content/provider support.
TMDB_API_KEY=

# Server-only worker/admin integration.
WORKER_API_URL=http://127.0.0.1:8200
WORKER_API_KEY=
LOG_LEVEL=INFO
PIPELINE_DAILY_HOUR_UTC=2
ANALYTICS_WEEKLY_DAY=sun
