TMDB_API_KEY=YOUR_TMDB_V3_API_KEY
MAL_CLIENT_ID=YOUR_MAL_CLIENT_ID
MAL_CLIENT_SECRET=YOUR_MAL_CLIENT_SECRET

SUPABASE_URL=https://ljcfbcpymbiyeyqlnqam.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional MAL OAuth values for authenticated/long-running imports.
# Public catalog endpoints work with MAL_CLIENT_ID alone.
MAL_ACCESS_TOKEN=
MAL_REFRESH_TOKEN=
MAL_REDIRECT_URI=

# Batch and pagination controls
BATCH_SIZE=100
MOVIE_PAGES=50
SERIES_PAGES=50
ANIME_PAGES=10

# Optional network controls
HTTP_TIMEOUT_SECONDS=30
REQUEST_RETRIES=4
TMDB_REQUEST_DELAY=0.05
MAL_REQUEST_DELAY=0.20
CAST_LIMIT=20
LOG_LEVEL=INFO

# Batch 2A downloads and caches the official IMDb non-commercial TSV files in
# data-pipeline/data/imdb. No AniList or TVMaze credentials are required.
