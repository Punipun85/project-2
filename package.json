{
  "name": "entertainment-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run build",
    "start": "next start",
    "test": "npm run build && node --import tsx --test tests/environment.test.ts tests/ai-routing.test.ts tests/ai-core.test.ts tests/recommendation-client.test.ts tests/personalization.test.ts tests/content-experience.test.ts tests/production-admin.test.ts tests/trailer-enrichment.test.ts tests/trailer-analysis.test.ts tests/trailer-apply.test.ts && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "embeddings:generate": "node --env-file-if-exists=.env --import tsx scripts/generate-embeddings.ts",
    "trailers:dry-run": "node --env-file-if-exists=.env --import tsx scripts/enrich-trailers.ts --dry-run",
    "trailers:apply": "node --env-file-if-exists=.env --import tsx scripts/enrich-trailers.ts --apply",
    "trailers:analyze": "node --env-file-if-exists=.env --import tsx scripts/analyze-trailer-report.ts",
    "trailers:apply-candidates": "node --env-file-if-exists=.env --import tsx scripts/apply-trailer-candidates.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
